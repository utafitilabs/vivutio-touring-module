{# A tour's page: what it is, its itinerary stay by stay with each night's
   lodge in each tier, and what the parks charge a party starting on a day. #}
{% extends '@Shell/page.html.twig' %}
{% import '@Shell/_icons.html.twig' as icons %}
{% import '@VivutioTouring/tours/_macros.html.twig' as tours_ %}

{% block title %}{{ tour.name }}{% endblock %}
{% block here %}tours{% endblock %}

{% block page %}
{%- set may = door('tours.manage') -%}
<header class="page-head">
    <div><nav class="trail" aria-label="Where you are"><a href="{{ path('touring_tours') }}">Tours</a> / {{ tour.name }}</nav><div class="title"><h1>{{ tour.name }}</h1>{{ tours_.status_chip(tour.status) }}</div>{% if tour.summary %}<p class="hint">{{ tour.summary }}</p>{% endif %}</div>
    <div class="actions"><a class="button outline" href="{{ path('touring_tours') }}">{{ icons.icon('left', 15) }} Back to tours</a>{% if may %}<a class="button outline" href="{{ path('touring_tour_configure', {uuid: tour.uuid}) }}">Configure</a>{% endif %}</div>
</header>

<div class="band">
    <span class="f"><span class="k">Length</span><span class="v" data-length>{{ schedule.days }} {{ schedule.days == 1 ? 'day' : 'days' }} · {{ schedule.nights }} {{ schedule.nights == 1 ? 'night' : 'nights' }}</span></span>
    {% if tour.tiers %}<span class="f"><span class="k">Sold in</span><span class="v">{{ tour.tiers|join(' · ') }}</span></span>{% endif %}
    <span class="f"><span class="k">Group</span><span class="v" data-group>{{ tour.groupMin }} to {{ tour.groupMax }}</span></span>
    {% if quote %}<span class="f"><span class="k">Park fees</span><span class="v">{{ tours_.amounts(quote.totals) }}</span></span>{% endif %}
</div>

<div class="columns">
    <div class="stack">
        <section class="panel">
            <header class="panel-head"><h2>Itinerary</h2><p>Each stay in order, and where its nights are spent</p>{% if may %}<a class="button small outline" href="{{ path('touring_tour_itinerary', {uuid: tour.uuid}) }}">Edit the itinerary</a>{% endif %}</header>
            <div class="stack">
            {% for day in tour.days %}
                <article class="day" data-day>
                    <header><h3>{{ schedule.labels[day.number] }} · {{ titles[day.number] }}</h3></header>
                    {% if day.destinations and day.title %}<div class="fact"><span>Route</span><b data-destinations>{% for key in day.destinations %}{{ names[key] ?? key }}{{ not loop.last ? ' → ' }}{% endfor %}</b></div>{% endif %}
                    {% for tier, lodge in stays[day.number] %}<div class="fact" data-stay><span>{{ tier }}</span><b>{{ lodge }}</b></div>{% endfor %}
                    {%- set meta = [] -%}
                    {%- if day.nights != 1 %}{% set meta = meta|merge([day.nights == 0 ? 'No night: the tour ends' : day.nights ~ ' nights']) %}{% endif -%}
                    {%- if day.meals %}{% set meta = meta|merge([day.meals|join(', ')|capitalize]) %}{% endif -%}
                    {%- if day.activities %}{% set meta = meta|merge([day.activities]) %}{% endif -%}
                    {%- if day.distanceKm is not null %}{% set meta = meta|merge([day.distanceKm ~ ' km']) %}{% endif -%}
                    {%- if day.driveHours is not null %}{% set meta = meta|merge([(day.driveHours|number_format(1)|trim('0', 'right')|trim('.', 'right')) ~ ' hours']) %}{% endif -%}
                    {% if meta %}<p class="hint" data-meta>{{ meta|join(' · ') }}</p>{% endif %}
                    {% if day.description %}<p class="hint">{{ day.description|nl2br }}</p>{% endif %}
                    {% if quote %}<div class="fact"><span>Park fees</span><b data-day-fees>{{ tours_.amounts(quote.days[day.number] ?? []) }}</b></div>{% endif %}
                </article>
            {% else %}
                <div class="empty"><b>No days yet</b><span>A tour is written stay by stay{% if may %}: <a href="{{ path('touring_tour_itinerary', {uuid: tour.uuid}) }}">write its itinerary</a>{% endif %}.</span></div>
            {% endfor %}
            </div>
        </section>
    </div>

    <aside class="aside stack">
        <section class="panel small" data-fees>
            <header class="panel-head"><h2>Price a party</h2><p>By the season of its first day</p></header>
            <form method="get" action="{{ path('touring_tour', {uuid: tour.uuid}) }}">
                <div class="field"><label for="fees-start">Starting</label><input class="input" id="fees-start" name="start" type="date" value="{{ asked.start }}"></div>
                <div class="grid-2">
                    <div class="field"><label for="fees-adults">Adults</label><input class="input" id="fees-adults" name="adults" type="number" min="1" value="{{ asked.adults }}"></div>
                    <div class="field"><label for="fees-children">Children</label><input class="input" id="fees-children" name="children" type="number" min="0" value="{{ asked.children }}"></div>
                </div>
                <div class="field"><label for="fees-tier">Tier</label><select class="select" id="fees-tier" name="tier">{% for t, tier in tier_names %}<option value="{{ t }}"{{ (t ~ '') == asked.tier ? ' selected' }}>{{ tier }}</option>{% endfor %}</select></div>
                <div class="field"><label for="fees-residency">Residency</label><select class="select" id="fees-residency" name="residency">{% for residency in residencies %}<option value="{{ residency.value }}"{{ residency.value == asked.residency ? ' selected' }}>{{ residency.label }}</option>{% endfor %}</select></div>
                <button type="submit" class="button outline">Price the party</button>
            </form>
            {% if price %}<p class="{{ price.priced ? '' : 'hint' }}" data-price>{% if price.priced %}<b>{{ price.says }}</b>{% else %}{{ price.says }}{% endif %}</p>{% endif %}
            {% if quote %}
                <div class="fact"><span>Park fees, all days</span><b data-fees-total>{{ tours_.amounts(quote.totals) }}</b></div>
                {% for line in quote.missing %}<p class="hint" data-missing>{{ line }}</p>{% endfor %}
            {% endif %}
        </section>
        {% if tour.included or tour.excluded %}
        <section class="panel small">
            <header class="panel-head"><h2>What it includes</h2></header>
            {% if tour.included %}<ul data-included>{% for item in tour.included %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
            {% if tour.excluded %}<p class="hint">Not included:</p><ul data-excluded>{% for item in tour.excluded %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
        </section>
        {% endif %}
    </aside>
</div>
{% endblock %}
