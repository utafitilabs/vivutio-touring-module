{# A field's refusal, said beside it, or its hint. #}
{% macro hint(field, wrong, hint) %}{% if wrong[field] is defined %}<div class="hint"><span>{{ wrong[field] }}</span></div>{% elseif hint %}<div class="hint"><span>{{ hint }}</span></div>{% endif %}{% endmacro %}

{# Amounts by currency, "USD 140.00 · TZS 23,600.00", or a dash for none. #}
{% macro amounts(byCurrency) -%}
{%- for currency, cents in byCurrency %}{{ currency }} {{ (cents / 100)|number_format(2) }}{{ not loop.last ? ' · ' }}{% else %}—{% endfor -%}
{%- endmacro %}

{# A tour's status as a chip. #}
{% macro status_chip(status) -%}
<span class="chip{{ status.value == 'open' ? ' ok' : '' }}">{{ status.label }}</span>
{%- endmacro %}

{# Configure's tabs: the tour's details, its itinerary, its prices, its costs and its departures. #}
{% macro tabs(tour, current) %}
<nav class="tabs" aria-label="Configure"><a href="{{ path('touring_tour_configure', {uuid: tour.uuid}) }}"{{ current == 'details' ? ' aria-current="page"' }}>Details</a><a href="{{ path('touring_tour_itinerary', {uuid: tour.uuid}) }}"{{ current == 'itinerary' ? ' aria-current="page"' }}>Itinerary</a><a href="{{ path('touring_tour_prices', {uuid: tour.uuid}) }}"{{ current == 'prices' ? ' aria-current="page"' }}>Prices</a><a href="{{ path('touring_tour_costs', {uuid: tour.uuid}) }}"{{ current == 'costs' ? ' aria-current="page"' }}>Costs</a><a href="{{ path('touring_tour_departures', {uuid: tour.uuid}) }}"{{ current == 'departures' ? ' aria-current="page"' }}>Departures</a></nav>
{% endmacro %}

{# Where a departure stands, as a chip: it runs, it wants seats to run, or neither. #}
{% macro standing_chip(standing) -%}
    <span class="chip{{ standing == 'Runs' ? ' ok' : (standing ends with 'to run' ? ' warn' : '') }}" data-runs>{{ standing }}</span>
{%- endmacro %}
